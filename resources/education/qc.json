{
  "mode": "regex",
  "checks": {
    "has_options": {"regex":"(?m)^\\s*[A-D]\\s*\\.","label":"选项集"},
    "has_answer": {"regex":"答案[：:]\\s*[A-D]","label":"答案"}
  },
  "require_all": ["has_options","has_answer"],
  "min_structure_score": 1,
  "drop_reason": {"missing":"缺少选项或答案","low_score":"题目结构不完整"}
}
