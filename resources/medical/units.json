  "lab_rules": [
    {"label":"WBC","pattern":"WBC\\s*(\\d+(?:\\.\\d+)?)\\s*×?\\s*10\\^?9\\s*/?\\s*L","min":3.5,"max":9.5,"flag":"lab.wbc.abnormal","level":"warning"},
    {"label":"PLT","pattern":"PLT\\s*(\\d+(?:\\.\\d+)?)\\s*×?\\s*10\\^?9\\s*/?\\s*L","min":100,"max":300,"flag":"lab.plt.abnormal","level":"warning"},
    {"label":"Hb","pattern":"HGB?\\s*(\\d+(?:\\.\\d+)?)\\s*g\\s*/\\s*L","min":110,"max":160,"flag":"lab.hb.abnormal","level":"warning"},
    {"label":"空腹血糖","pattern":"(?:空腹血糖|血糖)\\s*[:：\\s]*(\\d+(?:\\.\\d+)?)\\s*mmol\\s*/\\s*l","min":3.9,"max":6.1,"flag":"lab.glu.abnormal","level":"warning"},
    {"label":"ALT","pattern":"ALT\\s*(\\d+(?:\\.\\d+)?)\\s*U\\s*/\\s*l","min":5,"max":40,"flag":"lab.alt.abnormal","level":"warning"}
  ]
