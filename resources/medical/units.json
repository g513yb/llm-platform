  "dose_rules": [
    {"unit":"mg/kg","min":0.001,"max":100,"flag":"dose.implausible_high","level":"warning"},
    {"unit":"mg","min":0.01,"max":2000,"flag":"dose.implausible_high","level":"warning"},
    {"unit":"μg","min":0.1,"max":5000,"flag":"dose.implausible_high","level":"warning"},
    {"unit":"mL","min":1,"max":1000,"flag":"dose.implausible_high","level":"warning"},
    {"unit":"次/分","min":20,"max":250,"flag":"vital.implausible","level":"warning"}
