{
  "normalize": [
    {"pattern":"第\\s*([一二三四五六七八九十百零0-9]+)\\s*条","replacement":"第\\1条"},
    {"pattern":"第\\s*([一二三四五六七八九十百零0-9]+)\\s*款","replacement":"第\\1款"},
    {"pattern":"第\\s*([一二三四五六七八九十百零0-9]+)\\s*项","replacement":"第\\1项"},
    {"pattern":"第\\s*([一二三四五六七八九十百零0-9]+)\\s*编","replacement":"第\\1编"},
    {"pattern":"第\\s*([一二三四五六七八九十百零0-9]+)\\s*章","replacement":"第\\1章"},
    {"pattern":"第\\s*([一二三四五六七八九十百零0-9]+)\\s*节","replacement":"第\\1节"},
    {"pattern":"[（(]\\s*(20\\d{2})\\s*[）)]\\s*(最高法[^，。\\s]{0,14}?)\\s*(\\d+)\\s*号","replacement":"（\\1）\\2\\3号"}
  ],
  "hierarchy": {
    "level_order": {"doc":-1,"编":0,"章":1,"节":2,"条":3,"款":4,"项":5,"num":6},
    "cn_to_ar": true,
    "markers": [
      {"kind":"编","regex":"^\\s*第\\s*([一二三四五六七八九十百零0-9]{1,6})\\s*编(?:[\\s　]*[^\\n]*)?"},
      {"kind":"章","regex":"^\\s*第\\s*([一二三四五六七八九十百零0-9]{1,6})\\s*章"},
      {"kind":"节","regex":"^\\s*第\\s*([一二三四五六七八九十百零0-9]{1,6})\\s*节"},
      {"kind":"条","regex":"^\\s*第\\s*([一二三四五六七八九十百零0-9]{1,6})\\s*条"},
      {"kind":"款","regex":"^\\s*第\\s*([一二三四五六七八九十百零0-9]{1,6})\\s*款"},
      {"kind":"项","regex":"^\\s*[（(]\\s*([一二三四五六七八九十]+)\\s*[）)]"},
      {"kind":"num","regex":"^\\s*([一二三四五六七八九十]+)[、.]"},
      {"kind":"num","regex":"^\\s*\\(\\s*(\\d{1,2})\\s*\\)\\s*"}
    ]
  },
  "doc_types": {
    "判决书":   {"order":1,"require_all":["人民法院","判决书","判决如下"]},
    "裁定书":   {"order":2,"require_all":["人民法院","裁定书"]},
    "调解书":   {"order":3,"require_all":["调解书","调解协议|调解如下"]},
    "合同":     {"order":4,"require_all":["甲方","乙方"],"exclude_if":["判决","裁定","调解"]},
    "司法解释": {"order":5,"require_all":["法释〔|最高人民法院关于"]},
    "法规":     {"order":6,"require_all":["第[一二三四五六七八九十百零0-9]+条"],"exclude_if":["判决","裁定","调解","甲方"]}
  },
  "preserve_terms": ["法释[〔]","国发[〔]","司发[〔]","第[一二三四五六七八九十百零0-9]+条","〔[^〕]{4,20}〕","[（(]20\\d{2}[）)]","人民法院","民初","刑初","民终","刑终"]
}
