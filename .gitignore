.venv/
venv/
.venv-verify/
.venv-local/
__pycache__/
*.pyc
*.log
.DS_Store
.claude/
.pytest_cache/

# 数据处理产物：大 jsonl 可临时生成不入库；但 data/reference/ 下的原始拆分小文件(.json)与 manifest.json 入库溯源
data/**/*.jsonl
data/_inbox/

# 下载的原始数据集（download_datasets.py 落盘；云端重建 fixtures 用，不入库）
tests/fixtures/_downloads/
# 测试可视化报告（云端生成，不入库）
tests/report.html
tests/report.json

# 工具产物目录（agent 工具/IDE 在仓库内生成的缓存与索引，不入库）
**/.arts/
**/.codegraph/
**/.codeartsdoer/
**/llm-platform/

# 前端构建产物与依赖（frontend/）
frontend/node_modules/
frontend/dist/
frontend/package-lock.json
frontend/tsconfig.tsbuildinfo
frontend/dev-server.log
frontend/dev-server.err.log
frontend/.vite/

# 后端运行时上传目录（training.py 启动时 makedirs 自动创建）
server/datasets/

# 本地后端虚拟环境与启动日志（start-dev.ps1 生成，不入库）
.venv-server/
logs/

# 模型权重与 HuggingFace 缓存（大文件，各机器自行下载/挂载，不入库）
hf/
models/
